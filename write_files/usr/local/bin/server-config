#!/bin/bash
set -e
# server-config - Unified YAML-driven configuration wizard
# Usage: cat config.yaml | sudo server-config
#        sudo server-config --config /path/to/config.yaml
#        sudo server-config  (interactive prompts)

source /usr/local/lib/relay-common.sh
source /usr/local/lib/relay-secrets.sh

TEMPLATES_DIR="/etc/relay-server/templates"
ENV_FILE="/etc/environment.d/relay-server.conf"
CONFIG_FILE=""

while [[ $# -gt 0 ]]; do
  case $1 in --config) CONFIG_FILE="$2"; shift 2 ;; *) shift ;; esac
done

# Parse YAML config using yq and export variables
parse_yaml() {
  local yaml_file="$1"
  HEADSCALE_DOMAIN=$(yq '.headscale.domain' "$yaml_file")
  AZURE_TENANT_ID=$(yq '.headscale.oidc.tenant_id' "$yaml_file")
  AZURE_CLIENT_ID=$(yq '.headscale.oidc.client_id' "$yaml_file")
  AZURE_CLIENT_SECRET=$(yq '.headscale.oidc.client_secret' "$yaml_file")
  ALLOWED_EMAIL=$(yq '.headscale.oidc.allowed_email' "$yaml_file")
  MATRIX_ENABLED=$(yq '.matrix.enabled // "false"' "$yaml_file")
  MATRIX_DOMAIN=$(yq '.matrix.domain' "$yaml_file")
  MATRIX_SERVER_NAME=$(yq '.matrix.server_name' "$yaml_file")
  MATRIX_FEDERATION=$(yq '.matrix.federation // "false"' "$yaml_file")
  MATRIX_ALLOW_REGISTRATION=$(yq '.matrix.registration != "disabled"' "$yaml_file")
  MATRIX_REGISTRATION_TOKEN=$(yq '.matrix.registration_token // ""' "$yaml_file")
  SMTP_SENDER=$(yq '.smtp.sender_email' "$yaml_file")
  SMTP_RECIPIENT=$(yq '.smtp.recipient_email' "$yaml_file")
  SMTP_USER=$(yq '.smtp.smtp_user' "$yaml_file")
  SMTP_PASSWORD=$(yq '.smtp.smtp_password' "$yaml_file")
}

# Write environment file with all service vars
write_env_file() {
  mkdir -p "$(dirname "$ENV_FILE")"
  cat > "$ENV_FILE" << EOF
# Relay Server Configuration - Generated by server-config on $(date)
HEADSCALE_DOMAIN="${HEADSCALE_DOMAIN}"
AZURE_TENANT_ID="${AZURE_TENANT_ID}"
AZURE_CLIENT_ID="${AZURE_CLIENT_ID}"
AZURE_CLIENT_SECRET="${AZURE_CLIENT_SECRET}"
ALLOWED_EMAIL="${ALLOWED_EMAIL}"
MATRIX_DOMAIN="${MATRIX_DOMAIN}"
MATRIX_SERVER_NAME="${MATRIX_SERVER_NAME}"
MATRIX_FEDERATION="${MATRIX_FEDERATION}"
MATRIX_ALLOW_REGISTRATION="${MATRIX_ALLOW_REGISTRATION}"
MATRIX_REGISTRATION_TOKEN="${MATRIX_REGISTRATION_TOKEN}"
EOF
  chmod 600 "$ENV_FILE"
}

# Process templates via envsubst
process_templates() {
  export HEADSCALE_DOMAIN AZURE_TENANT_ID AZURE_CLIENT_ID AZURE_CLIENT_SECRET
  export ALLOWED_EMAIL MATRIX_DOMAIN MATRIX_SERVER_NAME
  export MATRIX_FEDERATION MATRIX_ALLOW_REGISTRATION MATRIX_REGISTRATION_TOKEN

  HEADSCALE_IP=$(getent ahosts "$HEADSCALE_DOMAIN" 2>/dev/null | awk '/STREAM/ {print $1; exit}')
  export HEADSCALE_IP

  envsubst < "$TEMPLATES_DIR/headscale.yaml.tpl" > /etc/headscale/config.yaml
  envsubst < "$TEMPLATES_DIR/headplane.yaml.tpl" > /etc/headplane/config.yaml
  envsubst < "$TEMPLATES_DIR/Caddyfile.tpl" > /etc/caddy/Caddyfile

  if [ "${MATRIX_ENABLED:-false}" = "true" ] && [ -f "$TEMPLATES_DIR/Caddyfile-matrix.tpl" ]; then
    envsubst < "$TEMPLATES_DIR/Caddyfile-matrix.tpl" >> /etc/caddy/Caddyfile
    envsubst < /etc/matrix-conduit/conduit.toml.tpl > /etc/matrix-conduit/conduit.toml
    chown conduit:conduit /etc/matrix-conduit/conduit.toml
  fi
}

# Detect input mode and load config vars
load_config() {
  if [ -n "$CONFIG_FILE" ]; then
    parse_yaml "$CONFIG_FILE"
  elif [ ! -t 0 ]; then
    TMPFILE=$(mktemp)
    cat > "$TMPFILE"
    parse_yaml "$TMPFILE"
    rm -f "$TMPFILE"
  else
    # Interactive mode: fall back to relay-config
    source /usr/local/lib/relay-validators.sh
    exec /usr/local/bin/relay-config
  fi
}
